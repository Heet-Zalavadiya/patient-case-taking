DATABASE_URL=sqlite:///./backend/medikiosk.db
# Put real credentials in an untracked .env file. Never commit them here.
GEMINI_API_KEY=your_gemini_api_key_here
SECRET_KEY=replace_with_a_long_random_secret
PATIENT_APP_URL=http://localhost:5173
DOCTOR_APP_URL=http://localhost:5174
PORT=3000

# Sarvam AI Configuration (Indian Language STT, Normalization, TTS)
SARVAM_API_KEY=your_sarvam_api_key_here
USE_SARVAM_AI=true
